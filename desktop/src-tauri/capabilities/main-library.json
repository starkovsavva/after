{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-library",
  "description": "Typed library operations for the local main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-workspace",
    "allow-get-meeting",
    "allow-choose-and-import",
    "allow-start-recording",
    "allow-recording-status",
    "allow-stop-recording",
    "allow-recoverable-recordings",
    "allow-recover-recording",
    "allow-feature-operation",
    "allow-save-note",
    "allow-save-folder",
    "allow-search-library",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
