{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-library",
  "description": "Only the five typed library operations, for the local main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-workspace",
    "allow-get-meeting",
    "allow-save-note",
    "allow-save-folder",
    "allow-search-library",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
